# Modo local sem servicos externos. Copie para .env; nunca versionar segredos.
# Processo Node no host. HOST/PORT/NODE_ENV nao configuram os containers.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
PERSISTENCE=memory
# Somente Node no host com PostgreSQL/Redis: preencha as URLs completas.
# Nao use ${POSTGRES_*} aqui: o env-file do Node nao expande essas referencias.
DATABASE_URL=
REDIS_URL=

# Docker Compose. No servidor, cada checkout precisa de projeto, imagem e porta diferentes.
COMPOSE_PROJECT_NAME=phasscode-platform
# Vazio deriva <COMPOSE_PROJECT_NAME>:local; release usa digest GHCR imutavel.
PHASSCODE_IMAGE=
# Porta publicada no host; a API continua ouvindo em 3000 dentro do container.
# O DEV remoto usa 3001. No PROD, 3000 (Grafana) e 3001 (DEV) sao proibidas:
# escolher uma porta LIVRE verificada no Mac Mini e configurar a mesma variavel no GitHub Environment production.
# O valor 3000 abaixo e somente o padrao para execucao local nao-prod.
PHASSCODE_HTTP_PORT=3000
# Compose preserva produção por padrão; fake Calendar/notificações só aceitos em development/test.
PHASSCODE_NODE_ENV=production
# Overrides opcionais: portas DB/Redis apenas para Node rodando no host.
PHASSCODE_POSTGRES_PORT=5432
PHASSCODE_REDIS_PORT=6379
POSTGRES_USER=phasscode
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=phasscode
# Compose deriva DATABASE_URL/REDIS_URL internas; nao preencha as URLs do host para ele.

# Opcoes compartilhadas entre host e containers.
CORS_ORIGINS=http://localhost:5173,https://gbc.phasscode.com,https://devgbc.phasscode.com
# Somente IPs/CIDRs de proxies confiaveis. Vazio = ignora X-Forwarded-For.
TRUST_PROXY=
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
CHAT_HISTORY_MESSAGES=12
CHAT_CONTEXT_CHARS=12000
CHAT_RETENTION_DAYS=7
CHAT_MAX_CONVERSATIONS=1000

# Selecao de LLM: false usa LLM_PROVIDER; true usa somente a cadeia abaixo.
# mock + false nao chama LLM. Com fallback ativo, nao repita chaves/modelos nos campos genericos.
LLM_PROVIDER=mock
LLM_FALLBACK_ENABLED=false
# Controles compartilhados pelos modos de LLM real.
LLM_TIMEOUT_MS=15000
LLM_MAX_OUTPUT_TOKENS=800
# Provedor real exige Redis e limite explicito: escolha conforme sua conta/modelo.
# Cada chamada ao modelo conta, incluindo rodadas adicionais apos ferramentas; nao e limite de tokens.
LLM_GLOBAL_MAX_CALLS=
LLM_GLOBAL_WINDOW_MS=86400000
LLM_GLOBAL_BUDGET_KEY=phasscode:llm:global
# Extensao OpenRouter, no modo unico ou no candidato OpenRouter da cadeia.
# Vazio preserva default do provedor.
# false desativa reasoning em modelos que permitem; nao apenas oculta o campo da resposta.
OPENROUTER_REASONING_ENABLED=

# Provedor unico: somente quando LLM_FALLBACK_ENABLED=false e LLM_PROVIDER nao e mock.
# Obrigatorios para openai ou openai-compatible; escolha um modelo da sua conta.
LLM_MODEL=
LLM_API_KEY=
# Obrigatoria somente para openai-compatible. URLs da cadeia de fallback sao fixas.
LLM_BASE_URL=
# responses (OpenAI) ou chat-completions (provedor compativel)
LLM_API_MODE=responses

# Fallback: somente quando LLM_FALLBACK_ENABLED=true. Exige Redis e cota global.
# Ordem: OpenRouter -> Gemini -> Groq -> Cohere; candidatos vazios sao ignorados.
# Nenhum modelo/cota e presumido gratuito: conferir conta, billing, termos e suporte a tools.
# Vazio deriva min(5000, LLM_TIMEOUT_MS); cada tentativa nunca excede o timeout total do turno.
LLM_FALLBACK_ATTEMPT_TIMEOUT_MS=
LLM_FALLBACK_COOLDOWN_MS=60000
LLM_FALLBACK_MAX_COOLDOWN_MS=86400000
LLM_FALLBACK_MAX_ATTEMPTS_PER_TURN=6
# Para cada provider usado, preencher API_KEY + MODEL + MAX_CALLS. Outros ficam todos vazios.
# Cada invocacao consome a cota do provider e a global.
# Janelas herdam LLM_GLOBAL_WINDOW_MS. Descomente um override somente se precisar divergir.
# OpenRouter permite somente ID terminado :free ou openrouter/free; nenhum fallback pago.
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_MODEL=
LLM_OPENROUTER_MAX_CALLS=
# LLM_OPENROUTER_WINDOW_MS=
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=
LLM_GEMINI_MAX_CALLS=
# LLM_GEMINI_WINDOW_MS=
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=
LLM_GROQ_MAX_CALLS=
# LLM_GROQ_WINDOW_MS=
# Cohere trial e somente avaliacao: vedado para producao ou uso comercial.
# Fallback gratuito rejeita Cohere em NODE_ENV=production (Compose: PHASSCODE_NODE_ENV).
# Fonte: https://cohere.com/pricing (FAQ Trial vs Production).
LLM_COHERE_API_KEY=
LLM_COHERE_MODEL=
LLM_COHERE_MAX_CALLS=
# LLM_COHERE_WINDOW_MS=

# Fase 3: desativada até configurar serviços. Não copie segredos para o chat ou Git.
AUTH_ENABLED=false
# Conta Google autorizada como administrador; obrigatorio quando AUTH_ENABLED=true.
AUTH_ADMIN_EMAIL=
AUTH_PUBLIC_URL=http://localhost:3000
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# npm run auth:keygen gera um fragmento privado em .secrets/auth-key.env (ignorado pelo Git/Docker).
AUTH_JWT_KEY_ID=
AUTH_JWT_PRIVATE_KEY=
# Rotação: somente chaves públicas anteriores, sem repetir o KEY_ID atual.
AUTH_JWT_PREVIOUS_JWKS=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=phasscode-api
# false permitido somente para HTTP local de desenvolvimento. Produção exige HTTPS e true.
AUTH_COOKIE_SECURE=true
AUTH_ACCESS_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=1800
AUTH_SESSION_MAX_SECONDS=28800
AUTH_HTTP_TIMEOUT_SECONDS=5

# Política confirmada pelo proprietário em 22/10/2026. Dias ISO: segunda=1, sábado=6.
# PENDING não reserva horário; reserva acontece ao aprovar.
MEETINGS_ENABLED=false
MEETINGS_TIMEZONE=America/Fortaleza
MEETINGS_WORKDAYS=1,2,3,4,5,6
MEETINGS_WORK_START=09:00
MEETINGS_WORK_END=18:00
MEETINGS_DURATION_MINUTES=30
MEETINGS_SLOT_STEP_MINUTES=15
MEETINGS_MIN_NOTICE_MINUTES=1440
MEETINGS_BUFFER_MINUTES=15
# Limites operacionais configuráveis; horizonte não é garantia de disponibilidade.
MEETINGS_MAX_HORIZON_DAYS=60
MEETINGS_MAX_AVAILABILITY_DAYS=7
MEETINGS_PROPOSAL_TTL_MINUTES=30
MEETINGS_CONSENT_VERSION=meetings-v1
MEETINGS_RETENTION_DAYS=90
MEETINGS_CALENDAR_LEASE_SECONDS=120

# Autorização Calendar INDEPENDENTE do login OIDC (client/secret/refresh próprios).
GOOGLE_CALENDAR_MODE=disabled
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_HTTP_TIMEOUT_MS=10000

# Worker é processo separado: npm run worker:dev / compose --profile worker up -d worker.
WORKER_ENABLED=false
NOTIFICATION_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_HTTP_TIMEOUT_MS=10000
OUTBOX_POLL_MS=1000
OUTBOX_LEASE_MS=120000
OUTBOX_MAX_ATTEMPTS=8
REMINDER_BEFORE_MINUTES=60

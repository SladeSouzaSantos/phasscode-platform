{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "conversationToken": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "sources": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["profile", "project", "service", "platform"]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["type", "id", "title"],
        "additionalProperties": false
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["mock", "openai", "openai-compatible"]
        },
        "simulated": {
          "type": "boolean"
        },
        "promptVersion": {
          "type": "string"
        }
      },
      "required": ["provider", "simulated", "promptVersion"],
      "additionalProperties": false
    }
  },
  "required": ["conversationId", "answer", "sources", "meta"],
  "additionalProperties": false
}

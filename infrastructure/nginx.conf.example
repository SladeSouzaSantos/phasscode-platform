# Proposta para /opt/projects/phasscode-platform/nginx.conf.
# O Nginx compartilhado ja inclui /opt/projects/*/nginx.conf. Nao adicionar outro proxy.
# Somente depois da validacao local: conectar api e proxy a uma rede Docker externa compartilhada,
# usar alias unico phasscode-api, remover publicacao da porta e configurar certificado/dominio reais.
# Este arquivo nao e instalado automaticamente; nomes .example sao deliberados.
server {
    listen 443 ssl;
    server_name api.phasscode.example;
    ssl_certificate /etc/nginx/certs/REPLACE/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/REPLACE/privkey.pem;
    client_max_body_size 8k;
    location / {
        proxy_pass http://phasscode-api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }
}

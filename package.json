{
  "name": "phasscode-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/orbe-node/src/main.ts",
    "worker:dev": "node --env-file-if-exists=.env --import tsx apps/worker-node/src/main.ts",
    "worker:start": "node --env-file-if-exists=.env dist/apps/worker-node/src/main.js",
    "auth:keygen": "node scripts/auth-keygen.mjs",
    "auth:admin": "node --env-file-if-exists=.env --import tsx packages/database/src/admin-role.ts",
    "start": "node --env-file-if-exists=.env dist/apps/orbe-node/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke.mjs",
    "smoke:phase3:docker": "node scripts/phase3-docker-smoke.mjs",
    "phase3:preflight": "node --import tsx scripts/phase3-preflight.ts",
    "eval:orbe": "node --env-file-if-exists=.env --import tsx scripts/evaluate-orbe.ts",
    "eval:orbe:phase3": "node --env-file-if-exists=.env --import tsx scripts/evaluate-orbe-phase3.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/infrastructure.test.ts'",
    "test:infrastructure": "vitest run tests/infrastructure.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "node scripts/b2-e2e.mjs",
    "test:watch": "vitest",
    "contracts:generate": "tsx packages/contracts/src/generate.ts",
    "contracts:check": "tsx packages/contracts/src/generate.ts --check",
    "migrate": "node --env-file-if-exists=.env --import tsx packages/database/src/migrate.ts",
    "migrate:prod": "node dist/packages/database/src/migrate.js",
    "db:retention": "node --env-file-if-exists=.env --import tsx packages/database/src/retention.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run contracts:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "10.13.0",
    "globals": "^16.5.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "yaml": "^2.8.1"
  }
}

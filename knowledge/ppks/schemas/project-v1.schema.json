{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phasscode.com/schemas/ppks/project-v1.schema.json",
  "title": "PHASSCODE Project Knowledge Schema v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "identity",
    "classification",
    "summary",
    "stack",
    "architecture",
    "features",
    "engineering",
    "competencies",
    "limitations",
    "evidence",
    "sync"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "kind": {
      "enum": ["project"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nature", "role", "repositoryUrl", "demoUrl", "visibility"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "nature": {
          "enum": ["personal", "professional", "study", "contribution", "unknown"]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repositoryUrl": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "demoUrl": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": ["public", "private", "third-party", "unknown"]
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationType", "domains", "engineeringAreas"],
      "properties": {
        "applicationType": {
          "enum": [
            "backend",
            "frontend",
            "fullstack",
            "mobile",
            "data",
            "ai",
            "devops",
            "library",
            "multi",
            "unknown"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "engineeringAreas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 20,
          "uniqueItems": true
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "technical", "problemSolved"],
      "properties": {
        "functional": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2500
        },
        "technical": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3500
        },
        "problemSolved": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "usage", "evidenceLevel", "evidenceIds"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "language",
              "framework",
              "library",
              "database",
              "tool",
              "platform",
              "infrastructure"
            ]
          },
          "usage": {
            "enum": ["implemented", "documented", "planned", "unconfirmed"]
          },
          "evidenceLevel": {
            "enum": ["verified", "declared", "inferred"]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 20,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 50,
      "uniqueItems": false
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "components", "patterns", "dataFlow"],
      "properties": {
        "style": {
          "enum": [
            "layered",
            "clean",
            "hexagonal",
            "mvc",
            "component",
            "service",
            "monolith",
            "multi",
            "unknown"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "maxItems": 40,
          "uniqueItems": true
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "application", "evidenceLevel", "evidenceIds"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "application": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evidenceLevel": {
                "enum": ["verified", "declared", "inferred"]
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "maxItems": 20,
                "uniqueItems": true
              }
            }
          },
          "maxItems": 25,
          "uniqueItems": false
        },
        "dataFlow": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "status", "evidenceIds"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1400
          },
          "status": {
            "enum": ["implemented", "documented", "planned", "unconfirmed"]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 20,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 50,
      "uniqueItems": false
    },
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "quality", "ciCd", "deployment", "security"],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "scope", "evidenceIds"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "maxItems": 20,
                "uniqueItems": true
              }
            }
          },
          "maxItems": 30,
          "uniqueItems": false
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "ciCd": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "deployment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "maxItems": 20,
          "uniqueItems": true
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "maxItems": 20,
          "uniqueItems": true
        }
      }
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "demonstrates", "evidenceLevel", "evidenceIds"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "demonstrates": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidenceLevel": {
            "enum": ["verified", "declared", "inferred"]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "maxItems": 15,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 40,
      "uniqueItems": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "status", "description"],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": ["not_implemented", "not_documented", "not_verified", "planned", "unknown"]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      },
      "maxItems": 30,
      "uniqueItems": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "url", "path", "note"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "source_code",
              "test",
              "workflow",
              "configuration",
              "documentation",
              "portfolio_record",
              "commit",
              "demo"
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "maxItems": 60,
      "uniqueItems": false
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRepository",
        "sourcePath",
        "sourceRef",
        "sourceCommit",
        "lastModifiedAt",
        "checkedAt",
        "analyzedAt",
        "reviewedAt",
        "verificationStatus",
        "syncEligible"
      ],
      "properties": {
        "sourceRepository": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "sourcePath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCommit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastModifiedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "analyzedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "verificationStatus": {
          "enum": ["catalog_only", "code_reviewed", "pending_review"]
        },
        "syncEligible": {
          "type": "boolean"
        }
      }
    }
  }
}

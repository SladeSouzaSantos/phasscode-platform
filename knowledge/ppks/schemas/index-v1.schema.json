{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phasscode.com/schemas/ppks/index-v1.schema.json",
  "title": "PHASSCODE Project Knowledge Index v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "projects",
    "experiences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "name",
          "applicationType",
          "technologies",
          "skills",
          "nature",
          "sourceCommit",
          "lastModifiedAt",
          "verificationStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 450
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "applicationType": {
            "enum": [
              "backend",
              "frontend",
              "fullstack",
              "mobile",
              "data",
              "ai",
              "devops",
              "library",
              "multi",
              "unknown"
            ]
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "maxItems": 50,
            "uniqueItems": true
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "maxItems": 40,
            "uniqueItems": true
          },
          "nature": {
            "enum": [
              "personal",
              "professional",
              "study",
              "contribution",
              "unknown"
            ]
          },
          "sourceCommit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastModifiedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "verificationStatus": {
            "enum": [
              "catalog_only",
              "code_reviewed",
              "pending_review"
            ]
          }
        }
      },
      "maxItems": 500,
      "uniqueItems": false
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "organization",
          "role",
          "technologies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 120
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 450
          },
          "organization": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "maxItems": 50,
            "uniqueItems": true
          }
        }
      },
      "maxItems": 100,
      "uniqueItems": false
    }
  }
}
